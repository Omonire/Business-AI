/* --- Reset & Base --- */

@define resets(){ `
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
`} 

@define base-style(){`
  html {
  fs: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  ff: 'Inter', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background-color: #f8fafc;
  color: #0f172a;
  line-height: 1.6;
  ovx: hidden;
}

a {
  color: inherit;
}

img,
svg {
  display: block;
}


button,
input {
  ff: inherit;
}
`} 
