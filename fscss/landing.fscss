/* ==========================================================
   Business AI - Landing + Auth
   FSCSS 1.2.5 structural stylesheet (landing, login, signup)
   ========================================================== */
@import((
  resets,
  base-style as base
) from "fscss/base.fscss")

@import((*) from flex-control)

@resets()
@base()

/* --- Layout utilities --- */

.container {
  max-w: 1160px;
  mx: auto;
  px: 24px;
}

.section {
  py: 96px;
}

.section-alt {
  bg: #ffffff;
  border-t: 1px solid #f1f5f9;
  border-b: 1px solid #f1f5f9;
}

.hide-mobile {
  display: inline;
}

@media (max-width: 640px) {
  .hide-mobile {
    display: none;
  }
}

/* --- Section headers --- */

.section-head {
  max-w: 640px;
  mx: auto;
  mb: 56px;
  ta: center;
}

.section-title {
  fs: 2.25rem;
  fw: 700;
  ls: -0.02em;
  lh: 1.15;
  color: #0f172a;
  mb: 16px;
}

.section-sub {
  fs: 1.0625rem;
  color: #64748b;
  lh: 1.7;
}

.section-caption {
  mt: 24px;
  ta: center;
  fs: 0.8125rem;
  color: #94a3b8;
}

/* --- Buttons --- */

.btn {
  @flex-center()
  gap: 8px;
  py: 10px;
  px: 18px;
  rounded: 10px;
  fs: 0.9375rem;
  fw: 600;
  td: none;
  border: 1px solid transparent;
  cur: pointer;
  trans: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
         color 0.2s ease,
         border-color 0.2s ease,
         box-shadow 0.2s ease,
         transform 0.15s ease;
  ws: nowrap;
}

.btn:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}

.btn-primary {
  bg: #2563eb;
  color: #ffffff;
  shadow: 0 1px 2px rgba(37, 99, 235, 0.2);
}

.btn-primary:hover {
  bg: #1d4ed8;
  shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
}

.btn-primary:active {
  tf: translateY(1px);
}

.btn-secondary {
  bg: #ffffff;
  color: #334155;
  border-color: #e2e8f0;
}

.btn-secondary:hover {
  border-color: #cbd5e1;
  bg: #f8fafc;
  color: #0f172a;
}

.btn-ghost {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.35);
}

.btn-ghost:hover {
  bg: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.6);
}

.btn-sm {
  py: 8px;
  px: 14px;
  fs: 0.875rem;
}

.btn-lg {
  py: 14px;
  px: 26px;
  fs: 1rem;
}

.btn-block {
  w: 100%;
}

.btn-arrow {
  size: 16px;
  trans: transform 0.2s ease;
}

.btn:hover .btn-arrow {
  tf: translateX(4px);
}

/* --- Navbar --- */

.navbar {
  pos: fixed;
  inset-x: 0;
  top: 0;
  z: 40;
  bg: rgba(248, 250, 252, 0.85);
  -*-backdrop-filter: blur(10px);
  border-b: 1px solid transparent;
  trans: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.navbar.scrolled {
  bg: rgba(255, 255, 255, 0.92);
  border-bottom-color: #f1f5f9;
  shadow: 0 1px 8px rgba(15, 23, 42, 0.05);
}

.navbar-inner {
  @flex-between()
  h: 72px;
}

.navbar-brand {
  @flex-y()
  gap: 12px;
  td: none;
}

.nav-menu {
  @flex-y()
  gap: 32px;
}

.nav-links {
  @flex-y()
  gap: 28px;
  list-style: none;
}

.nav-link {
  td: none;
  fs: 0.9375rem;
  fw: 500;
  color: #475569;
  trans: color 0.2s ease;
  pos: relative;
}

.nav-link:hover {
  color: #0f172a;
}

.nav-link::after {
  content: '';
  pos: absolute;
  left: 0;
  bottom: -6px;
  w: 100%;
  h: 2px;
  rounded: 2px;
  bg: #2563eb;
  tf: scaleX(0);
  transform-origin: left;
  trans: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-link:hover::after {
  tf: scaleX(1);
}

.nav-actions {
  @flex-x()
  gap: 16px;
}

.nav-signin {
  fs: 0.9375rem;
  fw: 600;
  color: #334155;
  td: none;
  trans: color 0.2s ease;
}

.nav-signin:hover {
  color: #2563eb;
}

.navbar-toggle {
  @flex-center()
  display: none;
  size: 42px;
  border: 1px solid #e2e8f0;
  rounded: 10px;
  bg: #ffffff;
  cur: pointer;
}

.navbar-toggle svg {
  size: 20px;
  color: #334155;
}

.navbar-toggle:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}

.nav-overlay {
  display: none;
  pos: fixed;
  inset: 0;
  z: 35;
  bg: rgba(15, 23, 42, 0.35);
  op: 0;
  trans: opacity 0.25s ease;
}

.nav-overlay.active {
  display: block;
  op: 1;
}

@media (max-width: 900px) {
  .navbar-toggle {
    display: flex;
  }

  .nav-menu {
    pos: fixed;
    top: 72px;
    inset-x: 0;
    z: 39;
    fdir: column;
    ai: stretch;
    gap: 12px;
    p: 24px;
    bg: #ffffff;
    border-b: 1px solid #f1f5f9;
    shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
    tf: translateY(-16px);
    op: 0;
    visibility: hidden;
    trans: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
           opacity 0.25s ease,
           visibility 0.25s;
  }

  .nav-menu.open {
    tf: translateY(0);
    op: 1;
    visibility: visible;
  }

  .nav-links {
    fdir: column;
    ai: stretch;
    gap: 8px;
  }

  .nav-link {
    display: block;
    py: 10px;
    px: 8px;
    fs: 1.0625rem;
    rounded: 8px;
  }

  .nav-link:hover {
    bg: #f8fafc;
  }

  .nav-link::after {
    display: none;
  }

  .nav-actions {
    fdir: column-reverse;
    gap: 10px;
  }

  .nav-signin {
    ta: center;
    p: 10px;
  }

  .nav-actions .btn {
    w: 100%;
  }
}

/* --- Hero --- */

.hero {
  pt: 168px;
  pb: 96px;
  pos: relative;
  ov: hidden;
}

.hero::before {
  content: '';
  pos: absolute;
  top: -180px;
  right: -160px;
  size: 560px;
  bg: radial-gradient(circle, rgba(37, 99, 235, 0.09), transparent 65%);
  pe: none;
}

.hero-inner {
  display: grid;
  grid-template-columns: 5fr 6fr;
  gap: 56px;
  ai: center;
}

.hero-eyebrow {
  @flex-inline()
  gap: 8px;
  py: 6px;
  px: 14px;
  rounded: 999px;
  bg: #eff6ff;
  border: 1px solid #dbeafe;
  color: #1d4ed8;
  fs: 0.8125rem;
  fw: 600;
  mb: 24px;
}

.hero-eyebrow-dot {
  size: 7px;
  rounded: 50%;
  bg: #2563eb;
  anim: hero-pulse 2.4s ease-in-out infinite;
}

@keyframes hero-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.35); }
  50% { box-shadow: 0 0 0 5px rgba(37, 99, 235, 0); }
}

.hero-title {
  fs: 3.4rem;
  fw: 700;
  ls: -0.03em;
  lh: 1.08;
  color: #0f172a;
  mb: 22px;
}

.hero-subtitle {
  fs: 1.125rem;
  lh: 1.7;
  color: #475569;
  max-w: 500px;
  mb: 32px;
}

.hero-actions {
  display: flex;
  ai: center;
  gap: 14px;
  fwrap: wrap;
  mb: 22px;
}

.hero-note {
  fs: 0.875rem;
  color: #94a3b8;
}

/* --- Hero visual & preview --- */

.hero-visual {
  pos: relative;
}

.float-chip {
  pos: absolute;
  @flex-y()
  gap: 8px;
  pt: 8px;
  pr: 14px;
  pb: 8px;
  pl: 8px;
  bg: #ffffff;
  border: 1px solid #e2e8f0;
  rounded: 12px;
  shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  fs: 0.8125rem;
  fw: 600;
  color: #334155;
  z: 3;
  anim: float-bob 6s ease-in-out infinite;
}

@arr y[
  top: -22px;,
  top: 60px;,
  top: 180px;,
  bottom: 120px;,
  bottom: -26px;,
  bottom: 40px;
]

@arr x[
  left: -30px;,
  right: -46px;,
  left: -58px;,
  right: -56px;,
  left: 30px;,
  right: -20px;
]
@arr indexes[count(@arr.y!.length, 1)]
empty{ /* preserve */ }

.float-chip-@arr.indexes[]{
  $i: @arr.indexes[];
  @arr.y[$i!]
  @arr.x[$i!]
}

@keyframes float-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

.float-chip-icon {
  size: 28px;
  rounded: 8px;
  center: both;
  shrink: 0;
}

.float-chip-icon svg {
  size: 16px;
}

.preview {
  bg: #ffffff;
  border: 1px solid #e2e8f0;
  rounded: 16px;
  shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
  ov: hidden;
}

.preview-bar {
  @flex-y()
  gap: 12px;
  py: 10px;
  px: 16px;
  border-b: 1px solid #f1f5f9;
  bg: #fbfcfe;
}

.preview-dots {
  @flex-gap(6px)
}

.preview-dots span {
  size: 10px;
  rounded: 50%;
}

.preview-dots span:nth-child(1) { bg: #f87171; }
.preview-dots span:nth-child(2) { bg: #fbbf24; }
.preview-dots span:nth-child(3) { bg: #34d399; }

.preview-url {
  fs: 0.75rem;
  color: #94a3b8;
  bg: #f1f5f9;
  rounded: 6px;
  py: 3px;
  px: 12px;
}

.preview-body {
  display: grid;
  grid-template-columns: 150px 1fr;
  min-h: 380px;
}

.preview-side {
  bg: #f8fafc;
  border-r: 1px solid #f1f5f9;
  py: 16px;
  px: 12px;
  @flex-col-gap(20px)
}

.preview-brand {
  @flex-y()
  gap: 8px;
  fs: 0.8125rem;
  fw: 700;
  color: #0f172a;
}

.preview-nav {
  list-style: none;
  @flex-col-gap(4px)
  flex: 1;
}

.preview-nav li {
  @flex-y()
  gap: 8px;
  py: 8px;
  px: 10px;
  rounded: 8px;
  fs: 0.75rem;
  fw: 500;
  color: #64748b;
}

.preview-nav li.active {
  bg: #eff6ff;
  color: #2563eb;
  fw: 600;
}

.preview-nav svg {
  size: 15px;
}

.preview-user {
  @flex-y()
  gap: 8px;
  pt: 12px;
  border-t: 1px solid #f1f5f9;
  fs: 0.75rem;
  color: #475569;
}

.preview-avatar {
  size: 26px;
  rounded: 50%;
  bg: #e2e8f0;
}

.preview-main {
  py: 20px;
  px: 24px;
  stack: 18px;
}

.preview-greeting {
  display: flex;
  jc: space-between;
  ai: flex-start;
}

.preview-greeting strong {
  display: block;
  fs: 1rem;
  color: #0f172a;
}

.preview-greeting span {
  fs: 0.78rem;
  color: #94a3b8;
}

.preview-bell {
  size: 30px;
  @flex-center()
  rounded: 8px;
  border: 1px solid #e2e8f0;
  color: #64748b;
}

.preview-bell svg {
  size: 16px;
}

.preview-command {
  @flex-y()
  gap: 10px;
  py: 12px;
  px: 14px;
  border: 1px solid #e2e8f0;
  rounded: 10px;
  bg: #f8fafc;
  color: #64748b;
  fs: 0.8125rem;
}

.preview-command-icon {
  size: 16px;
  color: #94a3b8;
  shrink: 0;
}

.preview-command span:nth-child(2) {
  flex: 1;
}

.preview-ask {
  bg: #2563eb;
  color: #ffffff;
  fs: 0.718rem;
  fw: 600;
  py: 5px;
  px: 12px;
  rounded: 7px;
}

.preview-stats {
  cols: 4;
  gap: 12px;
}

.preview-stat {
  border: 1px solid #f1f5f9;
  rounded: 10px;
  p: 12px;
  bg: #fff;
}

.preview-stat-value {
  display: block;
  fs: 1.125rem;
  fw: 700;
  color: #0f172a;
  ls: -0.01em;
}

.preview-stat-label {
  display: block;
  fs: 0.68rem;
  color: #94a3b8;
}

.preview-apps {
  @flex-y()
  gap: 8px;
}

.preview-app {
  size: 34px;
  @flex-center()
  rounded: 9px;
  border: 1px solid #e2e8f0;
  bg: #ffffff;
  color: #64748b;
}

.preview-app svg {
  size: 17px;
}

.preview-app-more {
  fs: 0.72rem;
  color: #94a3b8;
  ml: 2px;
}

/* --- Logo cloud --- */

.logo-cloud {
  cols: 5;
  gap: 16px;
}

.logo-item {
  @flex-y()
  gap: 12px;
  p: 16px;
  bg: #ffffff;
  border: 1px solid #f1f5f9;
  rounded: 12px;
  trans: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.logo-item:hover {
  border-color: #e2e8f0;
  shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
  tf: translateY(-2px);
}

.logo-icon {
  size: 38px;
  rounded: 10px;
  @flex-center()
  shrink: 0;
}

.logo-icon svg {
  size: 19px;
}

.logo-item span {
  fs: 0.875rem;
  fw: 600;
  color: #334155;
}

/* --- Problem section --- */

.problem-wrap {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 40px;
  ai: center;
}

.problem-panel {
  rounded: 16px;
  p: 28px;
}

.problem-chaos {
  bg: #ffffff;
  border: 1px solid #f1f5f9;
}

.problem-command {
  bg: #0f172a;
  color: #ffffff;
  border: 1px solid #1e293b;
}

.problem-panel-label {
  fs: 0.718rem;
  fw: 700;
  ls: 0.08em;
  tt: uppercase;
  mb: 18px;
}

.problem-chaos .problem-panel-label { color: #94a3b8; }
.problem-command .problem-panel-label { color: #7c8ba1; }

.chaos-headline {
  fs: 1.0625rem;
  fw: 600;
  color: #0f172a;
  mb: 18px;
}

.chaos-list {
  @flex-col-gap(12px)
}

.chaos-item {
  @flex-y()
  gap: 12px;
  py: 10px;
  px: 12px;
  rounded: 10px;
  bg: #fafbfc;
  border: 1px solid #f1f5f9;
}

.chaos-tile {
  size: 34px;
  @flex-center()
  rounded: 8px;
  fs: 0.718rem;
  fw: 700;
  shrink: 0;
}

.chaos-text {
  fs: 0.875rem;
  color: #475569;
}

.problem-arrow {
  size: 44px;
  rounded: 50%;
  bg: #2563eb;
  color: #ffffff;
  @flex-center()
  shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
}

.problem-arrow svg {
  size: 20px;
}

.command-mini {
  @flex-col()
}

.command-mini-top {
  @flex-y()
  gap: 10px;
  py: 12px;
  px: 14px;
  rounded: 10px;
  border: 1px solid #334155;
  bg: #1e293b;
  color: #cbd5e1;
  fs: 0.875rem;
  fw: 500;
}

.command-mini-top svg {
  size: 16px;
  color: #60a5fa;
}

.command-mini-divider {
  h: 1px;
  bg: #334155;
  my: 16px;
}

.command-mini-rows {
  @flex-col-gap(12px)
}

.command-mini-row {
  @flex-y()
  gap: 10px;
  fs: 0.8125rem;
  color: #94a3b8;
}

.command-mini-dot {
  size: 8px;
  rounded: 50%;
  shrink: 0;
}

.pain-list {
  list-style: none;
  display: flex;
  fwrap: wrap;
  jc: center;
  gap: 12px;
  mt: 56px;
}

.pain-list li {
  py: 8px;
  px: 18px;
  rounded: 999px;
  bg: #ffffff;
  border: 1px solid #e2e8f0;
}

/* --- Command bar (landing) --- */

.command-input {
  flex: 1;
  bg: transparent;
  border: none;
  outline: none;
  color: #f1f5f9;
  fs: 0.9375rem;
}

.command-input::placeholder {
  color: #64748b;
}

.command-submit {
  size: 36px;
  border: none;
  rounded: 9px;
  bg: #2563eb;
  color: #ffffff;
  center: both;
  cur: pointer;
  trans: background-color 0.2s ease, transform 0.15s ease;
}

.command-submit svg {
  size: 17px;
}

.command-submit:hover {
  bg: #1d4ed8;
  tf: scale(1.05);
}

.command-submit:focus-visible {
  outline: 2px solid #93c5fd;
  outline-offset: 2px;
}

.command-examples {
  display: flex;
  fwrap: wrap;
  jc: center;
  gap: 10px;
  mt: 22px;
}

.command-chip {
  py: 8px;
  px: 16px;
  rounded: 999px;
  border: 1px solid #334155;
  bg: #1e293b;
  color: #cbd5e1;
  fs: 0.8125rem;
  cur: pointer;
  trans: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
}

.command-chip:hover {
  border-color: #3b82f6;
  color: #ffffff;
  bg: #283548;
}

.command-chip:focus-visible {
  outline: 2px solid #93c5fd;
  outline-offset: 2px;
}

.command-note {
  mt: 20px;
  fs: 0.75rem;
  color: #64748b;
}

/* --- Features --- */

.feature-grid {
  cols: 4;
  gap: 20px;
}

.feature {
  bg: #ffffff;
  border: 1px solid #f1f5f9;
  rounded: 14px;
  p: 24px;
  trans: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.feature:hover {
  border-color: #e2e8f0;
  shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
  tf: translateY(-3px);
}

.feature-icon {
  size: 44px;
  rounded: 11px;
  center: both;
  mb: 18px;
}

.feature-icon svg {
  size: 20px;
}

.feature-title {
  fs: 1.0625rem;
  fw: 600;
  color: #0f172a;
  mb: 8px;
}

.feature-text {
  fs: 0.875rem;
  color: #64748b;
  lh: 1.65;
}

/* --- Safety --- */

.safety-steps {
  cols: 3;
  gap: 20px;
  mb: 40px;
}

.safety-step {
  bg: #ffffff;
  border: 1px solid #f1f5f9;
  rounded: 14px;
  p: 26px;
}

.safety-step-head {
  display: flex;
  ai: center;
  jc: space-between;
  mb: 14px;
}

.safety-badge {
  fs: 0.718rem;
  fw: 700;
  ls: 0.08em;
  py: 5px;
  px: 12px;
  rounded: 7px;
}

.safety-title {
  fs: 1.125rem;
  fw: 600;
  color: #0f172a;
}

.safety-text {
  fs: 0.9375rem;
  color: #64748b;
  lh: 1.7;
}

.safety-note {
  display: flex;
  ai: center;
  jc: center;
  gap: 12px;
  max-w: 620px;
  mx: auto;
  py: 16px;
  px: 22px;
  bg: #eff6ff;
  border: 1px solid #dbeafe;
  rounded: 12px;
  color: #1e40af;
  fs: 0.9375rem;
}

.safety-note svg {
  size: 18px;
  shrink: 0;
}

.safety-note strong {
  fw: 700;
}

/* --- Final CTA --- */

.section-cta {
  p: 0;
}

.cta-panel {
  ta: center;
  pos: relative;
  ov: hidden;
  my: 96px;
  py: 88px;
  px: 40px;
  bg: #0f172a;
  rounded: 20px;
}

.cta-panel::before {
  content: '';
  pos: absolute;
  top: -120px;
  left: 50%;
  tf: translateX(-50%);
  w: 640px;
  h: 320px;
  bg: radial-gradient(ellipse, rgba(37, 99, 235, 0.4), transparent 70%);
  pe: none;
}

.cta-title {
  pos: relative;
  fs: 2.75rem;
  fw: 700;
  ls: -0.02em;
  lh: 1.12;
  color: #ffffff;
  mb: 18px;
}

.cta-sub {
  pos: relative;
  fs: 1.125rem;
  color: #94a3b8;
  mb: 36px;
}

.cta-actions {
  pos: relative;
  display: flex;
  jc: center;
  gap: 14px;
  fwrap: wrap;
  mb: 18px;
}

.cta-note {
  pos: relative;
  fs: 0.8125rem;
  color: #64748b;
}

/* --- Footer --- */

.footer {
  bg: #ffffff;
  border-t: 1px solid #f1f5f9;
  pt: 72px;
  pb: 32px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  gap: 40px;
  mb: 48px;
}

.footer-brand {
  mb: 16px;
}

.footer-tagline {
  fs: 0.9375rem;
  color: #64748b;
  max-w: 260px;
  mb: 20px;
}

.footer-social {
  display: flex;
  gap: 10px;
}

.social-link {
  size: 36px;
  rounded: 9px;
  border: 1px solid #e2e8f0;
  center: both;
  color: #64748b;
  trans: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
}

.social-link:hover {
  border-color: #cbd5e1;
  bg: #f8fafc;
  color: #0f172a;
}

.social-link svg {
  size: 16px;
}

.footer-heading {
  fs: 0.8125rem;
  fw: 700;
  ls: 0.06em;
  tt: uppercase;
  color: #0f172a;
  mb: 16px;
}

.footer-links {
  list-style: none;
  stack: 10px;
}

.footer-links a {
  td: none;
  fs: 0.9375rem;
  color: #64748b;
  trans: color 0.2s ease;
}

.footer-links a:hover {
  color: #2563eb;
}

.footer-bottom {
  display: flex;
  jc: space-between;
  ai: center;
  gap: 12px;
  fwrap: wrap;
  pt: 28px;
  border-t: 1px solid #f1f5f9;
  fs: 0.8125rem;
  color: #94a3b8;
}

/* ==========================================================
   Auth pages
   ========================================================== */

.auth-page {
  min-h: 100vh;
  bg: #f8fafc;
  pos: relative;
}

.auth-page::before {
  content: '';
  pos: absolute;
  top: -160px;
  right: -140px;
  size: 480px;
  bg: radial-gradient(circle, rgba(37, 99, 235, 0.08), transparent 65%);
  pe: none;
}

.auth-shell {
  min-h: 100vh;
  center: both;
  py: 80px;
  px: 24px;
}

.auth-card {
  w: 100%;
  max-w: 420px;
  bg: #ffffff;
  border: 1px solid #f1f5f9;
  rounded: 18px;
  pt: 40px;
  px: 40px;
  pb: 32px;
  shadow: 0 16px 48px rgba(15, 23, 42, 0.06);
}

.auth-card-wide {
  max-w: 460px;
}

.auth-brand {
  display: inline-flex;
  ai: center;
  gap: 12px;
  td: none;
  mb: 32px;
}

.auth-heading {
  mb: 28px;
}

.auth-title {
  fs: 1.625rem;
  fw: 700;
  ls: -0.02em;
  color: #0f172a;
  mb: 6px;
}

.auth-subtext {
  fs: 0.9375rem;
  color: #64748b;
}

.auth-back {
  pos: fixed;
  top: 24px;
  left: 24px;
  z: 10;
  display: inline-flex;
  ai: center;
  gap: 8px;
  py: 8px;
  px: 12px;
  rounded: 9px;
  fs: 0.875rem;
  fw: 500;
  color: #475569;
  td: none;
  trans: background-color 0.2s ease, color 0.2s ease;
}

.auth-back:hover {
  bg: #ffffff;
  color: #0f172a;
}

.auth-back svg {
  size: 16px;
}

.auth-back:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}

.btn-google {
  w: 100%;
  bg: #ffffff;
  color: #334155;
  border-color: #e2e8f0;
  gap: 10px;
}

.btn-google:hover {
  bg: #f8fafc;
  border-color: #cbd5e1;
}

.google-mark {
  size: 18px;
}

.auth-divider {
  display: flex;
  ai: center;
  gap: 16px;
  my: 24px;
  color: #94a3b8;
  fs: 0.8125rem;
}

.auth-divider::before,
.auth-divider::after {
  content: '';
  flex: 1;
  h: 1px;
  bg: #f1f5f9;
}

.auth-form {
  stack: 18px;
}

.field {
  stack: 6px;
}

.field-label {
  fs: 0.875rem;
  fw: 600;
  color: #334155;
}

.field-control {
  display: flex;
  ai: center;
  gap: 10px;
  px: 14px;
  h: 48px;
  rounded: 10px;
  border: 1px solid #e2e8f0;
  bg: #ffffff;
  trans: border-color 0.2s ease, box-shadow 0.2s ease;
  pos: relative;
}

.field-control:focus-within {
  border-color: #2563eb;
  shadow: 0 0 0 3px rgba(37, 99, 235, 0.09);
}

.field-icon {
  size: 17px;
  color: #94a3b8;
  shrink: 0;
}

.field-control input {
  flex: 1;
  border: none;
  outline: none;
  bg: transparent;
  fs: 0.9375rem;
  color: #0f172a;
  h: 100%;
}

.field-control input::placeholder {
  color: #94a3b8;
}

.field-control.has-error {
  border-color: #ef4444;
}

.field-control.has-error:focus-within {
  shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.field-error {
  fs: 0.8125rem;
  color: #dc2626;
  min-h: 0;
  display: none;
}

.field-error.visible {
  display: block;
}

.field-hint {
  fs: 0.8125rem;
  color: #94a3b8;
}

.password-toggle {
  size: 30px;
  border: none;
  bg: transparent;
  cur: pointer;
  center: both;
  color: #94a3b8;
  rounded: 7px;
  trans: color 0.2s ease, background-color 0.2s ease;
  shrink: 0;
}

.password-toggle:hover {
  color: #475569;
  bg: #f1f5f9;
}

.password-toggle:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 1px;
}

.eye {
  size: 17px;
}

.eye-hide {
  display: none;
}

.password-toggle.visible .eye-show {
  display: none;
}

.password-toggle.visible .eye-hide {
  display: block;
}

.auth-row {
  display: flex;
  ai: center;
  jc: space-between;
  gap: 12px;
}

.auth-link {
  color: #2563eb;
  fs: 0.875rem;
  fw: 600;
  td: none;
  trans: color 0.2s ease;
}

.auth-link:hover {
  color: #1d4ed8;
  td: underline;
}

.auth-check {
  display: inline-flex;
  ai: center;
  gap: 10px;
  fs: 0.875rem;
  color: #475569;
  cur: pointer;
}

.auth-check input {
  pos: absolute;
  op: 0;
  size: 0;
}

.auth-check-box {
  size: 18px;
  rounded: 5px;
  border: 1px solid #cbd5e1;
  bg: #ffffff;
  center: both;
  shrink: 0;
  trans: background-color 0.2s ease, border-color 0.2s ease;
}

.auth-check-box svg {
  size: 11px;
  color: #ffffff;
  op: 0;
  trans: opacity 0.15s ease;
}

.auth-check input:checked + .auth-check-box {
  bg: #2563eb;
  border-color: #2563eb;
}

.auth-check input:checked + .auth-check-box svg {
  op: 1;
}

.auth-check input:focus-visible + .auth-check-box {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}

.auth-check-terms {
  ai: flex-start;
}

.auth-terms-text {
  lh: 1.5;
}

.auth-foot {
  ta: center;
  fs: 0.9375rem;
  color: #64748b;
  pt: 4px;
}

/* Reveal + reduced motion (unchanged logic) */

html.js-reveal .reveal {
  op: 0;
  tf: translateY(26px);
  trans: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
         transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

html.js-reveal .reveal.is-visible {
  op: 1;
  tf: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  html {
    scroll-behavior: auto;
  }

  html.js-reveal .reveal {
    op: 1;
    tf: none;
  }

  .float-chip {
    anim: none;
  }

  .hero-eyebrow-dot {
    anim: none;
  }

  .navbar {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
}

/* --- Responsive --- */

@media (max-width: 1024px) {
  .hero-inner {
    grid-template-columns: 1fr;
    gap: 64px;
  }

  .hero-copy {
    ta: center;
  }

  .hero-subtitle {
    mx: auto;
  }

  .hero-actions {
    jc: center;
  }

  .hero-visual {
    max-w: 640px;
    mx: auto;
    w: 100%;
  }

  .float-chip-2 { right: -10px; }
  .float-chip-4 { right: -14px; }
  .float-chip-6 { right: -4px; }
  .float-chip-1 { left: -8px; }
  .float-chip-3 { left: -14px; }
  .float-chip-5 { left: 10px; }

  .logo-cloud {
    cols: 3;
  }

  .feature-grid {
    cols: 2;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .footer-brand-col {
    grid-column: 1 / -1;
  }
}

@media (max-width: 640px) {
  .section {
    py: 64px;
  }

  .section-title {
    fs: 1.75rem;
  }

  .section-head {
    mb: 40px;
  }

  .hero {
    pt: 128px;
    pb: 64px;
  }

  .hero-title {
    fs: 2.4rem;
  }

  .hero-actions .btn {
    w: 100%;
  }

  .float-chip {
    display: none;
  }

  .preview-stats {
    cols: 2;
  }

  .preview-body {
    grid-template-columns: 1fr;
  }

  .preview-side {
    display: none;
  }

  .problem-wrap {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .problem-arrow {
    mx: auto;
    tf: rotate(90deg);
  }

  .steps {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .feature-grid {
    cols: 1;
  }

  .safety-steps {
    cols: 1;
    gap: 16px;
  }

  .command-title {
    fs: 1.75rem;
  }

  .command-examples {
    fdir: column;
    ai: stretch;
  }

  .command-chip {
    ta: left;
  }

  .cta-panel {
    my: 48px;
    py: 64px;
    px: 24px;
    rounded: 16px;
  }

  .cta-title {
    fs: 2rem;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .footer-links {
    gap: 8px;
  }

  .footer-bottom {
    jc: center;
    fdir: column;
    ta: center;
  }

  .auth-card {
    pt: 32px;
    px: 24px;
    pb: 24px;
  }

  .auth-back {
    top: 16px;
    left: 16px;
  }
}
